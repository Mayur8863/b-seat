# BSeat environment variables.
# Copy to `.env` for local overrides: cp .env.example .env
# Every value below is a LOCAL DEV default. Never commit a real secret; in AWS
# these come from Secrets Manager / SSM Parameter Store (see docs/runbooks).
# docker-compose.yml already has these defaults, so .env is optional locally.

# ---- Postgres ---------------------------------------------------------------
# Superuser for the local container (also owns the app schema).
POSTGRES_USER=bseat
POSTGRES_PASSWORD=bseat
POSTGRES_DB=bseat
# Host port Postgres is published on (5433 to avoid clashing with a host Postgres).
POSTGRES_PORT=5433
# Password of the SELECT-only `bseat_readonly` role used by the Postgres MCP server.
POSTGRES_READONLY_PASSWORD=bseat_readonly
# App connection strings. Inside compose the host is `postgres`; compose sets
# these automatically, override only when running outside compose.
# DATABASE_URL=postgres://bseat:bseat@localhost:5433/bseat
# DATABASE_URL_TEST=postgres://bseat:bseat@localhost:5433/bseat_test

# ---- Redis (cache + BullMQ queues) ------------------------------------------
REDIS_PORT=6380
# REDIS_URL=redis://localhost:6380

# ---- Mail (Mailpit catches all mail locally: http://localhost:8025) ---------
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
MAIL_FROM="BSeat <no-reply@bseat.local>"

# ---- API (NestJS) -----------------------------------------------------------
API_PORT=3001
# pino level: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# ---- Auth (Better Auth, hosted inside the API) ------------------------------
# 32+ random chars. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me-0000000000
# Public origin the browser sees. The web app proxies /api/* to the API, so
# this is the WEB origin, which keeps auth cookies first-party.
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated origins allowed to call auth endpoints.
TRUSTED_ORIGINS=http://localhost:3000

# ---- Seed (demo data) -------------------------------------------------------
# Password for the demo accounts owner@bseat.local and renter@bseat.local created
# by `bin/pnpm db:seed` (8+ chars). LOCAL/CI ONLY: the API refuses to start with it
# set in production. Compose already gives the `migrate` service a dev-only default;
# uncomment only to override it (every node service then receives it via .env).
# SEED_DEMO_PASSWORD=dev-only-demo-password-1

# ---- Web (Next.js) ----------------------------------------------------------
WEB_PORT=3000
# Public URL of the web app (used for absolute links, e.g. in emails).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Where the Next.js server reaches the API (compose sets http://api:3001).
# API_INTERNAL_URL=http://localhost:3001

# ---- Observability ----------------------------------------------------------
OTEL_SERVICE_NAME=bseat-api
# OTLP/HTTP collector. Start Jaeger with: docker compose --profile observability up
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# Set true to turn tracing off entirely.
OTEL_SDK_DISABLED=true

# ---- AI tooling (MCP servers in .mcp.json) — export in your shell, not here --
# Fine-grained GitHub PAT for the GitHub MCP server (repo: issues, PRs, contents read).
# GITHUB_PERSONAL_ACCESS_TOKEN=
# Optional Context7 API key (higher rate limits).
# CONTEXT7_API_KEY=
