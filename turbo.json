{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".env.example", "tsconfig.json"],
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "gen:api": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../apps/api/openapi.json"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "gen:api"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*"]
    },
    "typecheck": {
      "dependsOn": ["^build", "gen:api"]
    },
    "lint": {
      "dependsOn": ["^build", "gen:api"]
    },
    "test": {
      "dependsOn": ["^build", "gen:api"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build", "gen:api"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
