  "info": {
    "title": "BSeat API",
    "description": "Seat and desk booking API. Errors use RFC 9457 problem details.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "bseat.session_token"
      }
    },
    "schemas": {
      "Reference": {
        "type": "object",
        "properties": {
          "countries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$",
                  "description": "ISO 3166-1 alpha-2 country code, e.g. IN"
                },
                "name": {
                  "type": "string"
                },
                "timeZones": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "IANA time zone, e.g. Europe/London"
                  },
                  "description": "Suggested zones (may be empty); the first is the default"
                }
              },
              "required": [
                "code",
                "name",
                "timeZones"
              ],
              "additionalProperties": false
            }
          },
          "currencies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$",
                  "description": "ISO 4217 currency code, e.g. INR"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "name"
              ],
              "additionalProperties": false
            }
          },
          "utilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "wifi",
                "air_conditioning",
                "power_backup",
                "parking",
                "meeting_room",
                "tea_coffee",
                "printer",
                "lockers",
                "security_24h",
                "cafeteria",
                "accessible_entrance"
              ]
            }
          }
        },
        "required": [
          "countries",
          "currencies",
          "utilities"
        ],
        "additionalProperties": false,
        "description": "Static lists used by listing and preference forms"
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "URI identifying the problem type"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "errors": {
            "description": "Field-level validation errors",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "additionalProperties": false
      },
      "SpaceList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Space"
            }
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false,
        "description": "Every space, ordered by name"
      },
      "Space": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "timeZone": {
            "type": "string",
            "description": "IANA time zone, e.g. Europe/London"
          },
          "seatCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "name",
          "location",
          "timeZone",
          "seatCount"
        ],
        "additionalProperties": false,
        "description": "An office space people can book seats in"
      },
      "AvailabilityQueryInput": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "description": "Date in the space's time zone (YYYY-MM-DD)"
          },
          "startTime": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "description": "Wall-clock time in the space's time zone (HH:mm)"
          },
          "endTime": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "description": "Wall-clock time in the space's time zone (HH:mm)"
          }
        },
        "required": [
          "date",
          "startTime",
          "endTime"
        ]
      },
      "SpaceAvailability": {
        "type": "object",
        "properties": {
          "space": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "name": {
                "type": "string"
              },
              "location": {
                "type": "string"
              },
              "timeZone": {
                "type": "string",
                "description": "IANA time zone, e.g. Europe/London"
              }
            },
            "required": [
              "id",
              "name",
              "location",
              "timeZone"
            ],
            "additionalProperties": false
          },
          "window": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date",
